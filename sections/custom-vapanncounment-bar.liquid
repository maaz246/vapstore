{% comment %}
  Custom Vapstore Marquee Infinite Announcement Bar Section
  Features:
  - Infinite seamless CSS marquee animation (no gaps, no stutter)
  - Customizable black background, crisp white typography & accent highlights
  - Customizable speed, direction, pause on hover, font size, padding, spacing
  - Built-in icons (Shipping, Fire, Discount, Star, Sparkle, Shield, Vape, Leaf, Gift) + Custom SVG
  - Badges, highlighted text & custom HTML / liquid block support
{% endcomment %}

{{ 'custom-vapanncounment-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #vap-announcement-bar-{{ section.id }} {
    --vap-marquee-bg: {{ section.settings.bg_color }};
    --vap-marquee-text-color: {{ section.settings.text_color }};
    --vap-marquee-accent: {{ section.settings.accent_color }};
    --vap-marquee-separator-color: {{ section.settings.separator_color }};
    --vap-marquee-duration: {{ section.settings.speed }}s;
    --vap-marquee-gap: {{ section.settings.gap }}px;
    --vap-marquee-font-size: {{ section.settings.font_size }}px;
    --vap-marquee-font-size-mobile: {{ section.settings.font_size_mobile }}px;
    --vap-marquee-font-weight: {{ section.settings.font_weight }};
    --vap-marquee-letter-spacing: {{ section.settings.letter_spacing }}px;
    --vap-marquee-transform: {{ section.settings.text_transform }};
    background-color: var(--vap-marquee-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.show_border_bottom -%}
      border-bottom: 1px solid {{ section.settings.border_color }};
    {%- endif -%}
  }
{%- endstyle -%}

{%- capture separator_html -%}
  {%- if section.settings.separator_style != 'none' -%}
    <span class="vap-marquee__separator" aria-hidden="true">
      {%- case section.settings.separator_style -%}
        {%- when 'star' -%}
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0L14.8 9.2L24 12L14.8 14.8L12 24L9.2 14.8L0 12L9.2 9.2L12 0Z"/>
          </svg>
        {%- when 'dot' -%}
          •
        {%- when 'diamond' -%}
          ❖
        {%- when 'dash' -%}
          —
        {%- when 'slash' -%}
          //
      {%- endcase -%}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- capture items_html -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'announcement' -%}
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="vap-marquee__item" {{ block.shopify_attributes }}>
          {%- else -%}
            <span class="vap-marquee__item" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.badge_text != blank -%}
              <span
                class="vap-marquee__badge"
                style="background-color: {{ block.settings.badge_bg }}; color: {{ block.settings.badge_color }};"
              >
                {{ block.settings.badge_text | escape }}
              </span>
            {%- endif -%}

            {%- if block.settings.icon != 'none' -%}
              <span class="vap-marquee__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                  {%- when 'fire' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 23c-4.97 0-9-4.03-9-9 0-3.66 2.19-6.8 5.37-8.17.43-.19.92.09 1.01.55.15.75.46 1.45.89 2.06.33.47.98.54 1.4.15 1.57-1.46 2.65-3.4 3.06-5.55.08-.43.47-.73.91-.71.44.02.8.35.86.79.49 3.54 2.1 6.55 4.5 8.88.35.34.46.86.26 1.3-.2.44-.66.7-1.14.65-1.07-.11-2.12-.51-3.03-1.16-.41-.29-.98-.19-1.26.23-.33.5-.53 1.08-.57 1.69-.06.94.31 1.84.99 2.49.37.35.41.93.09 1.33C14.73 22.07 13.41 23 12 23z"/>
                    </svg>
                  {%- when 'discount' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5L12 0Z"/>
                    </svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                      <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                  {%- when 'vape' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="6" width="10" height="15" rx="3"></rect>
                      <path d="M10 6V3h4v3"></path>
                      <line x1="12" y1="11" x2="12" y2="15"></line>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                    </svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 12 20 22 4 22 4 12"></polyline>
                      <rect x="2" y="7" width="20" height="5"></rect>
                      <line x1="12" y1="22" x2="12" y2="7"></line>
                      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                  {%- when 'custom_svg' -%}
                    {{ block.settings.custom_svg_code }}
                {%- endcase -%}
              </span>
            {%- endif -%}

            <span class="vap-marquee__text">
              {{ block.settings.text | escape }}
              {%- if block.settings.highlight_text != blank -%}
                <span
                  class="vap-marquee__highlight"
                  {% if block.settings.highlight_color != blank %}
                    style="color: {{ block.settings.highlight_color }};"
                  {% endif %}
                >
                  {{ block.settings.highlight_text | escape }}
                </span>
              {%- endif -%}
            </span>

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}

          {{ separator_html }}
        {%- endif -%}

      {%- when 'custom_html' -%}
        {%- if block.settings.html != blank -%}
          <div class="vap-marquee__item vap-marquee__html" {{ block.shopify_attributes }}>
            {{ block.settings.html }}
          </div>
          {{ separator_html }}
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="vap-announcement-bar-wrapper"
  id="vap-announcement-bar-{{ section.id }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}"
>
  <div class="vap-marquee{% if section.settings.pause_on_hover %} vap-marquee--pause-hover{% endif %}">
    <div class="vap-marquee__viewport">
      <div class="vap-marquee__track{% if section.settings.direction == 'right' %} vap-marquee__track--right{% endif %}">
        {%- comment -%} Output duplicated groups so the track width is filled and loops with 0 stutter {%- endcomment -%}
        <div class="vap-marquee__group">
          {{ items_html }}
          {{ items_html }}
          {{ items_html }}
          {{ items_html }}
        </div>
        <div class="vap-marquee__group" aria-hidden="true">
          {{ items_html }}
          {{ items_html }}
          {{ items_html }}
          {{ items_html }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vap Marquee Bar",
  "tag": "section",
  "class": "section-custom-vap-announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#cf7238"
    },
    {
      "type": "header",
      "content": "Marquee Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed (Duration)",
      "default": 24,
      "info": "Lower is faster, higher is slower."
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semi-Bold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        },
        {
          "value": "800",
          "label": "Extra Bold (800)"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 1
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Case",
      "options": [
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "none",
          "label": "Normal (none)"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Item Separator"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Separator Symbol",
      "options": [
        {
          "value": "star",
          "label": "✦ Star"
        },
        {
          "value": "dot",
          "label": "• Dot"
        },
        {
          "value": "diamond",
          "label": "❖ Diamond"
        },
        {
          "value": "dash",
          "label": "— Dash"
        },
        {
          "value": "slash",
          "label": "// Slash"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "star"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#cf7238"
    },
    {
      "type": "header",
      "content": "Spacing & Borders"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Spacing Between Items",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Bottom Border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#222222"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "FREE EXPRESS SHIPPING ON ALL ORDERS OVER $50"
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Highlight Word / Code",
          "default": "• CODE: FREESHIP"
        },
        {
          "type": "color",
          "id": "highlight_color",
          "label": "Custom Highlight Color",
          "default": "#cf7238"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "No Icon"
            },
            {
              "value": "shipping",
              "label": "🚚 Shipping Truck"
            },
            {
              "value": "fire",
              "label": "🔥 Fire / Hot"
            },
            {
              "value": "discount",
              "label": "🏷️ Discount / Tag"
            },
            {
              "value": "star",
              "label": "⭐ Star"
            },
            {
              "value": "sparkle",
              "label": "✨ Sparkle"
            },
            {
              "value": "shield",
              "label": "🛡️ 100% Authentic / Shield"
            },
            {
              "value": "vape",
              "label": "💨 Vape Device"
            },
            {
              "value": "leaf",
              "label": "🍃 Pure & Natural / Leaf"
            },
            {
              "value": "gift",
              "label": "🎁 Free Gift"
            },
            {
              "value": "custom_svg",
              "label": "Custom SVG"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "html",
          "id": "custom_svg_code",
          "label": "Custom SVG Code",
          "info": "Paste custom SVG icon code if 'Custom SVG' is selected above."
        },
        {
          "type": "header",
          "content": "Badge (Optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "info": "e.g. HOT, NEW, LIMITED"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background",
          "default": "#cf7238"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Text Color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "custom_html",
      "name": "Custom HTML / Code",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "Custom Content HTML",
          "default": "<span>⚡ SAME DAY DISPATCH BEFORE 2PM</span>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vap Marquee Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "FREE EXPRESS SHIPPING ON ALL ORDERS OVER $50",
            "highlight_text": "USE CODE: VAPESHIP",
            "icon": "shipping",
            "badge_text": "FREE"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "100% AUTHENTIC GUARANTEED PRODUCTS",
            "highlight_text": "DIRECT FROM MANUFACTURER",
            "icon": "shield",
            "badge_text": "VERIFIED"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "NEW ARRIVALS NOW IN STOCK",
            "highlight_text": "UP TO 30% OFF",
            "icon": "fire",
            "badge_text": "HOT"
          }
        }
      ]
    }
  ]
}
{% endschema %}
